{
  "name": "auto-premium-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tenant:new": "tsx scripts/tenant.ts new",
    "tenant:check": "tsx scripts/tenant.ts check",
    "tenant:publish": "tsx scripts/tenant.ts publish",
    "tenant:verify": "tsx scripts/tenant.ts verify",
    "supabase:deploy": "supabase db push && supabase functions deploy api --no-verify-jwt",
    "deploy": "pnpm build && vercel --prod"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.7",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.90.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "liquid-gl": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supabase": "^2.53.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
